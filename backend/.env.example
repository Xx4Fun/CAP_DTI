APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

RECEIPT_CONTINUOUS_CAPTURE_ENABLED=false
RECEIPT_ABANDONED_CAPTURE_HOURS=24
DB_QUEUE_RETRY_AFTER=480
RECEIPT_WEB_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:replace-with-approved-dti-contact@example.gov.ph
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RECEIPT_EVIDENCE_DISK=receipt_evidence
RECEIPT_EVIDENCE_DRIVER=local
RECEIPT_EVIDENCE_BUCKET=receipt-evidence
RECEIPT_EVIDENCE_ENDPOINT=
RECEIPT_EVIDENCE_ACCESS_KEY_ID=
RECEIPT_EVIDENCE_SECRET_ACCESS_KEY=
FRONTEND_URL=http://localhost:5173
VENDOR_PWA_URL=http://localhost:5176
VENDOR_TOKEN_HOURS=720
# Official legal notice PDFs and attachments; use s3 in production (falls back to RECEIPT_EVIDENCE_* S3 settings)
LEGAL_DOCUMENTS_DRIVER=local
# Fallback signatory names; a Super Admin normally sets these in DTI Admin > Settings > Legal Signatories.
# Each notice type can be issued once its own signatory name is set (LOI and SCO are enabled separately).
LEGAL_POLICY_APPROVED=true
LEGAL_LOI_SIGNATORY_NAME=
LEGAL_SCO_SIGNATORY_NAME=
ADMIN_IDLE_TIMEOUT_MINUTES=15
ADMIN_ABSOLUTE_TIMEOUT_HOURS=8
ADMIN_REAUTHENTICATION_MINUTES=5

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
COMMODITY_IMAGE_DISK=public
QUEUE_CONNECTION=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PHILSMS_API_TOKEN=
PHILSMS_API_ENDPOINT=
PHILSMS_SENDER_ID=

# Tesseract OCR Configuration
# Windows example: TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Linux example: TESSERACT_PATH="/usr/bin/tesseract"
TESSERACT_PATH=
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT_SECONDS=15
TESSERACT_RECEIPT_PASS_TIMEOUT_SECONDS=60
# Capped at 300 seconds to leave room before the receipt job's 360-second timeout.
TESSERACT_RECEIPT_PROCESSING_BUDGET_SECONDS=300
TESSERACT_PSM=11
TESSERACT_SHELF_TAG_PASS_TIMEOUT_SECONDS=3
TESSERACT_SHELF_TAG_PRIMARY_PSM=6
TESSERACT_SHELF_TAG_FALLBACK_PSM=11
TESSERACT_SHELF_TAG_MINIMUM_CONFIDENCE=30
# TESSERACT_TEMP_DIRECTORY=

# Receipt extraction provider: tesseract (default) or gemini.
RECEIPT_EXTRACTION_PROVIDER=tesseract
# Comma-separated privacy notice versions whose reports may be sent to Gemini (set at DPO sign-off).
RECEIPT_EXTRACTION_CONSENT_VERSIONS=
# Required outside local/testing, together with a GEMINI_BILLING_ATTESTED value.
RECEIPT_EXTRACTION_PRODUCTION_APPROVED=false
RECEIPT_EXTRACTION_MAX_CALLS_PER_ATTEMPT=6
RECEIPT_EXTRACTION_MAX_CALLS_PER_REPORT=18
RECEIPT_EXTRACTION_DAILY_CALL_LIMIT=200
RECEIPT_EXTRACTION_DAILY_TOKEN_LIMIT=3000000

# Gemini API (backend only; never expose in frontend code). Keep the key out of version control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used on subsequent attempts after a transient provider failure; empty disables fallback.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
# Per-image resolution: low, medium, high, or ultra_high.
GEMINI_IMAGE_RESOLUTION=high
GEMINI_TIMEOUT_SECONDS=90
# Optional CA bundle path for local machines without system CA certificates (TLS stays verified).
# GEMINI_CA_BUNDLE=
# Attestation for what the key actually is (the code cannot verify this claim):
# paid = paid project, required for real customer receipts. free_tier_demo = demonstration on the free tier,
# where Google may use submitted content and humans may review it: project team receipts only.
GEMINI_BILLING_ATTESTED=
